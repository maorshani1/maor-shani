<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE66D">

    <!-- App title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🕐 שעון שלי"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-rounded"
        android:shadowColor="#40000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:paddingTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Large hour name in Hebrew -->
    <TextView
        android:id="@+id/tvHourHebrew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שתים עשרה"
        android:textSize="52sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-rounded"
        android:shadowColor="#40000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="6"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Full Hebrew time sentence -->
    <TextView
        android:id="@+id/tvTimeDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שעה שתים עשרה בדיוק!"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-rounded"
        android:alpha="0.9"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvHourHebrew"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Minute label -->
    <TextView
        android:id="@+id/tvMinuteLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textColor="#FFFFFFCC"
        android:fontFamily="sans-serif-rounded"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTimeDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The interactive clock -->
    <com.hebrewclock.ClockView
        android:id="@+id/clockView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvMinuteLabel"
        app:layout_constraintBottom_toTopOf="@id/btnNow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1" />

    <!-- Star burst overlay (hidden by default) -->
    <TextView
        android:id="@+id/tvStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐"
        android:textSize="72sp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="@id/clockView"
        app:layout_constraintBottom_toBottomOf="@id/clockView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Show current time" button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnNow"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginBottom="28dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="30dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <TextView
                android:id="@+id/btnNowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰  מה השעה עכשיו?"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#E63946"
                android:fontFamily="sans-serif-rounded" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
